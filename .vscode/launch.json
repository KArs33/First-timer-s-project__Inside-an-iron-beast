{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run IAIB Program (MinGW-w64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/driver.exe",
            "args": ["loc.txt", "foe.txt"],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build IAIB Debug"
        },
        {
            "name": "Attach to running IAIB Program (MinGW-w64)",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/driver.exe",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "cwd": "${workspaceFolder}",
            "externalConsole": true
        }
    ]
}
