{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run driver for IAIB Program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/driver.exe",
            "args": ["loc.txt", "foe.txt"],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build IAIB Program"
        }

        ,
        {
            "name": "Attach to running driver",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/driver.exe",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "cwd": "${workspaceFolder}",
            "externalConsole": true
        }

    ]
}